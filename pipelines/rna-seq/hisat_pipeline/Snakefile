# Snakefile for the rna-seq pipeline
import os

# Make the pipeline runnable from anywhere: paths below are relative to the
# repo root, so pin config + working directory to it regardless of where
# snakemake is launched. workflow.basedir = this Snakefile's directory.
REPO_ROOT = os.path.abspath(os.path.join(workflow.basedir, "..", "..", ".."))
configfile: os.path.join(workflow.basedir, "config.yml")
workdir: REPO_ROOT

SAMPLES = config["samples"]
CONDITIONS = config["conditions"]
RUN = config["run_id"]
GENOME_DIR = config["genome_dir"]
GENOME_FASTA_GZ = config["genome_fasta_gz"]
GENOME_GTF_GZ = config["genome_gtf_gz"]
GENOME_FASTA = GENOME_FASTA_GZ[:-len(".gz")]
GENOME_GTF = GENOME_GTF_GZ[:-len(".gz")]

# ============================================
# Target finale: i report FastQC prima e dopo il trimming
# ============================================
rule all:
    input:
        expand("results/rna-seq/{run}/genome/genome_index_prefix",
               run=RUN)

# ============================================
# Step 1: decompress genome for next analysis
# ============================================
rule decompress_genome:
    input:
        fasta_gz = GENOME_FASTA_GZ,
        gtf_gz = GENOME_GTF_GZ
    output:
        fasta = GENOME_FASTA,
        gtf = GENOME_GTF
    shell:
        "gunzip -k {input.fasta_gz} && gunzip -k {input.gtf_gz}"

# ============================================
# Step 2.1: generate the hint on splice site and on exons
# ============================================
rule hisat_extract_splice:
    input:
        gtf = GENOME_GTF
    output:
        output = "results/rna-seq/{run}/genome/genome.ss"
    conda:
        "../envs/rna-seq.yml"
    threads: 2
    shell: "hisat2_extract_splice_sites.py {input.gtf} > {output}"

# ============================================
# Step 2.2: generate the hint on splice site and on exons
# ============================================
rule hisat_extract_exons:
    input:
        gtf = GENOME_GTF
    output:
        output = "results/rna-seq/{run}/genome/genome.exon"
    conda:
        "../envs/rna-seq.yml"
    threads: 2
    shell: "hisat2_extract_exon.py {input.gtf} > {output}"

# ============================================
# Step 3: generate the index using hisat2 algorithm
# ============================================
rule hisat_build_index:
    input:
        fasta = GENOME_FASTA,
        ss_file = "results/rna-seq/{run}/genome/genome.ss",
        exon_file = "results/rna-seq/{run}/genome/genome.exon"
    output:
        directory("results/rna-seq/{run}/genome/genome_index_prefix")
    conda:
        "../envs/rna-seq.yml"
    threads: 2
    shell: "hisat2-build -p {threads} \
  --ss {input.ss_file} --exon {input.exon_file} \
  {input.fasta} {output}"
